{
  "description": "Adds the Agrippa core rules to every session at startup, resume, clear, and after compaction, and to every subagent, with the low-usage line after them only when the project sets AGRIPPA_LOW_USAGE=1. Logs subagent spawns to subagent-spawns.log only when the project sets AGRIPPA_SPAWN_LOG=1.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/inject_core_rules.mjs\" SessionStart"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/inject_core_rules.mjs\" SubagentStart"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/log_subagent_spawns.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/log_subagent_spawns.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
