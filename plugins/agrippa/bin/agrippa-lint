#!/bin/sh
# agrippa-lint: run the Agrippa plan-workspace linter from the plugin.
#
# Claude Code puts this plugin's bin/ folder on the Bash tool's PATH while the
# plugin is enabled, so a plan's validation matrix can name the linter as
# `agrippa-lint -PlanPath plans/YYYY-MM-DD-name` with no version-specific
# path. The folder is not on the PowerShell tool's PATH, so that row runs
# through the Bash tool.
#
# Every argument passes through to scripts/validate_plan_workspace.ps1. It
# finds the repository root from the current directory unless -RepoRoot is
# given, and its exit code is this command's exit code.

linter="$(dirname -- "$0")/../scripts/validate_plan_workspace.ps1"
if [ ! -f "$linter" ]; then
  echo "agrippa-lint: the linter is missing at $linter" >&2
  exit 2
fi

# Windows PowerShell needs a Windows path. Git Bash and Cygwin provide cygpath.
if command -v cygpath >/dev/null 2>&1; then
  linter=$(cygpath -w "$linter")
fi

if command -v powershell >/dev/null 2>&1; then
  shell=powershell
elif command -v pwsh >/dev/null 2>&1; then
  shell=pwsh
else
  echo "agrippa-lint: needs Windows PowerShell (powershell) or PowerShell 7 (pwsh) on PATH" >&2
  exit 127
fi

exec "$shell" -NoProfile -ExecutionPolicy Bypass -File "$linter" "$@"
