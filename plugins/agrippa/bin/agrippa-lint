#!/bin/sh
# agrippa-lint: run the Agrippa plan-workspace linter from the plugin.
#
# Claude Code puts this plugin's bin/ folder on the Bash tool's PATH while the
# plugin is enabled, so a plan's validation matrix can name the linter as
# `agrippa-lint -PlanPath plans/YYYY-MM-DD-name` with no version-specific
# path. The folder is not on the PowerShell tool's PATH, so that row runs
# through the Bash tool. Git Bash, which the Bash tool uses on Windows, runs
# this file through the shebang line above and sets $0 to the full path it
# found on PATH, which is how the linter beside it is located.
#
# Every argument passes through to scripts/validate_plan_workspace.pl, whose
# exit code is this command's exit code. The linter needs perl, which Git for
# Windows bundles and macOS and Linux ship; without it this prints one plain
# line and exits 2, the linter's usage-error code, so the matrix row fails
# loudly instead of with a shebang error.

# Git for Windows puts perl in /usr/bin, which its bin/sh.exe launcher adds
# to PATH but its bare usr/bin/sh.exe does not. Harmless elsewhere.
PATH=/usr/bin:$PATH
export PATH

if ! command -v perl >/dev/null 2>&1; then
    printf '%s\n' 'agrippa-lint: perl is required to run the plan-workspace linter and is not on PATH. On Windows it comes with Git for Windows; on macOS and Linux it ships with the system.' >&2
    exit 2
fi

exec perl "$(dirname "$0")/../scripts/validate_plan_workspace.pl" "$@"
